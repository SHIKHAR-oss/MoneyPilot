# ==========================================
# MoneyPilot Backend Production Environment Variables
# ==========================================

# Server Runtime Configuration
PORT=5000
NODE_ENV=production

# Frontend Client URL(s) for CORS (Comma-separated for multiple origins)
CLIENT_URL=https://your-frontend-app.vercel.app,http://localhost:5173

# MongoDB Atlas Connection String (Never commit real credentials)
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/moneypilot?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/moneypilot

# Authentication Secret (Minimum 32-character random string)
JWT_SECRET=your_secure_random_jwt_secret_key_minimum_32_characters
JWT_EXPIRES_IN=7d

# Google Gemini AI Configuration (Backend-only proxy; never exposed to frontend)
GEMINI_API_KEY=your_google_gemini_api_key
GEMINI_MODEL=gemini-1.5-flash
