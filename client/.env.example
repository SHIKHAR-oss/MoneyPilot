# ==========================================
# MoneyPilot Frontend Production Environment Variables
# ==========================================

# Backend API Base URL (Point to your deployed Render/Railway backend)
# Example: https://moneypilot-backend.onrender.com/api
VITE_API_BASE_URL=https://your-backend-api.onrender.com/api

# Cloudflare Turnstile Bot Protection Site Key (Public)
# Testing site key (always passes): 1x00000000000000000000AA
VITE_TURNSTILE_SITE_KEY=your_cloudflare_turnstile_site_key
